@@ -0,0 +1,142 @@
+// Managed launchers may require security hooks independently of owner-editable config.
+import { z } from "zod";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { GlobalHookRunnerRegistry } from "./hook-registry.types.js";
+import { getGlobalHookRunnerRegistry } from "./hook-runner-global-state.js";
+import { isConversationHookName, isPluginHookName, type PluginHookName } from "./hook-types.js";
+
+const requirementSchema = z.strictObject({
+  version: z.literal(1),
+  plugins: z
+    .array(
+      z.strictObject({
+        id: z.string().min(1).max(256).regex(/^\S+$/u),
+        hooks: z.array(z.custom<PluginHookName>(isPluginHookName)).min(1).max(64),
+      }),
+    )
+    .min(1)
+    .max(64),
+});
+
+// Capture once, before plugin execution. Owner config/reloads cannot remove the
+// launcher's requirements, and hot paths never reread files or process.env.
+const launchRequirements = process.env.OPENCLAW_REQUIRED_PLUGINS;
+let requirements:
+  | ReadonlyArray<{ readonly id: string; readonly hooks: readonly PluginHookName[] }>
+  | undefined;
+let gatewayLoadState: "unmanaged" | "loading" | "ready" = "unmanaged";
+let loadGeneration = 0;
+
+export function getRequiredPluginRequirements() {
+  if (requirements !== undefined) {
+    return requirements;
+  }
+  if (launchRequirements === undefined) {
+    requirements = Object.freeze([]);
+    return requirements;
+  }
+  try {
+    if (Buffer.byteLength(launchRequirements, "utf8") > 16_384) {
+      throw new Error("oversized requirements");
+    }
+    const parsed = requirementSchema.parse(JSON.parse(launchRequirements));
+    if (
+      new Set(parsed.plugins.map((plugin) => plugin.id)).size !== parsed.plugins.length ||
+      parsed.plugins.some((plugin) => new Set(plugin.hooks).size !== plugin.hooks.length)
+    ) {
+      throw new Error("duplicate requirements");
+    }
+    requirements = Object.freeze(
+      parsed.plugins.map((plugin) =>
+        Object.freeze({
+          id: plugin.id,
+          hooks: Object.freeze(plugin.hooks),
+        }),
+      ),
+    );
+    return requirements;
+  } catch {
+    // Do not echo launcher input; diagnostics must not disclose accidental secrets.
+    throw new Error("Invalid OPENCLAW_REQUIRED_PLUGINS launcher policy");
+  }
+}
+
+export function assertRequiredPluginConfiguration(config: OpenClawConfig | undefined): void {
+  for (const required of getRequiredPluginRequirements()) {
+    const plugins = config?.plugins;
+    if (
+      plugins?.enabled === false ||
+      plugins?.entries?.[required.id]?.enabled !== true ||
+      plugins?.deny?.includes(required.id) ||
+      (plugins?.allow && plugins.allow.length > 0 && !plugins.allow.includes(required.id)) ||
+      (required.hooks.some(isConversationHookName) &&
+        plugins?.entries?.[required.id]?.hooks?.allowConversationAccess !== true)
+    ) {
+      throw new Error(`Required plugin configuration unavailable: ${required.id}`);
+    }
+  }
+}
+
+function assertRequiredPluginRegistry(registry: GlobalHookRunnerRegistry | null): void {
+  for (const required of getRequiredPluginRequirements()) {
+    const matching = registry?.plugins.filter((plugin) => plugin.id === required.id) ?? [];
+    if (matching.length !== 1 || matching[0].status !== "loaded") {
+      throw new Error(`Required plugin did not load: ${required.id}`);
+    }
+    for (const hookName of required.hooks) {
+      if (
+        !registry?.typedHooks.some(
+          (hook) =>
+            hook.pluginId === required.id &&
+            hook.hookName === hookName &&
+            typeof hook.handler === "function",
+        )
+      ) {
+        throw new Error(`Required plugin hook unavailable: ${required.id}/${hookName}`);
+      }
+    }
+  }
+}
+
+export function beginRequiredPluginLoad(): number {
+  if (getRequiredPluginRequirements().length > 0) {
+    // Remain closed if loading throws. Pinned old registries must not conceal a
+    // failed replacement; only a complete successful gateway reload reopens it.
+    gatewayLoadState = "loading";
+    loadGeneration += 1;
+  }
+  return loadGeneration;
+}
+
+export function completeRequiredPluginLoad(
+  registry: GlobalHookRunnerRegistry,
+  config: OpenClawConfig,
+  generation: number,
+): void {
+  if (getRequiredPluginRequirements().length > 0) {
+    gatewayLoadState = "loading";
+    // A later rejected config or overlapping reload invalidates this attempt.
+    // An older completion must never reopen admission over the newer decision.
+    if (generation !== loadGeneration) {
+      throw new Error("Superseded required plugin reload");
+    }
+  }
+  assertRequiredPluginConfiguration(config);
+  assertRequiredPluginRegistry(registry);
+  if (getRequiredPluginRequirements().length > 0) {
+    gatewayLoadState = "ready";
+  }
+}
+
+export function assertRequiredPluginRuntime(config: OpenClawConfig | undefined): void {
+  if (getRequiredPluginRequirements().length === 0) {
+    return;
+  }
+  assertRequiredPluginConfiguration(config);
+  if (gatewayLoadState === "loading") {
+    throw new Error("Required plugin runtime is not ready");
+  }
+  // Scoped harness/memory registries are intentionally partial. Check the same
+  // composed live registry the dispatcher uses, never an individual setter.
+  assertRequiredPluginRegistry(getGlobalHookRunnerRegistry());
+}
