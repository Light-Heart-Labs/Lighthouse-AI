diff --git a/src/agents/agent-tools.required-plugins.test.ts b/src/agents/agent-tools.required-plugins.test.ts
new file mode 100644
index 00000000..92049945
--- /dev/null
+++ b/src/agents/agent-tools.required-plugins.test.ts
@@ -0,0 +1,96 @@
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+
+let tools: typeof import("./agent-tools.before-tool-call.js");
+let hooks: typeof import("../plugins/hook-runner-global.js");
+let runtime: typeof import("../plugins/runtime.js");
+let required: typeof import("../plugins/required-plugins.js");
+let empty: typeof import("../plugins/registry-empty.js");
+let records: typeof import("../plugins/status.test-helpers.js");
+const config: OpenClawConfig = {
+  plugins: {
+    entries: {
+      guard: { enabled: true, hooks: { allowConversationAccess: true } },
+    },
+  },
+};
+
+beforeAll(async () => {
+  vi.resetModules();
+  vi.stubEnv(
+    "OPENCLAW_REQUIRED_PLUGINS",
+    JSON.stringify({
+      version: 1,
+      plugins: [{ id: "guard", hooks: ["before_tool_call"] }],
+    }),
+  );
+  [tools, hooks, runtime, required, empty, records] = await Promise.all([
+    import("./agent-tools.before-tool-call.js"),
+    import("../plugins/hook-runner-global.js"),
+    import("../plugins/runtime.js"),
+    import("../plugins/required-plugins.js"),
+    import("../plugins/registry-empty.js"),
+    import("../plugins/status.test-helpers.js"),
+  ]);
+});
+afterEach(() => {
+  hooks.resetGlobalHookRunner();
+  runtime.resetPluginRuntimeStateForTest();
+});
+afterAll(() => {
+  vi.unstubAllEnvs();
+  vi.resetModules();
+});
+
+function installGuard() {
+  const registry = empty.createEmptyPluginRegistry();
+  const handler = vi.fn(() => undefined);
+  registry.plugins.push(records.createPluginRecord({ id: "guard" }));
+  registry.typedHooks.push({
+    pluginId: "guard",
+    hookName: "before_tool_call",
+    handler,
+    source: "fixture",
+  });
+  runtime.setActivePluginRegistry(registry);
+  hooks.initializeGlobalHookRunner(registry);
+  required.completeRequiredPluginLoad(registry, config, required.beginRequiredPluginLoad());
+  return { registry, handler };
+}
+const call = () => tools.runBeforeToolCallHook({ toolName: "read", params: {}, ctx: { config } });
+
+describe("mandatory tool-call admission", () => {
+  it("blocks even when no hook runner exists", async () => {
+    hooks.resetGlobalHookRunner();
+    runtime.resetPluginRuntimeStateForTest();
+    expect(await call()).toMatchObject({ blocked: true, kind: "failure" });
+  });
+
+  it("uses actual composed hooks when an unrelated scoped registry becomes active", async () => {
+    const { registry, handler } = installGuard();
+    runtime.pinActivePluginChannelRegistry(registry);
+    const scoped = empty.createEmptyPluginRegistry();
+    runtime.setActivePluginRegistry(scoped);
+    hooks.initializeGlobalHookRunner(scoped);
+    expect(await call()).toMatchObject({ blocked: false });
+    expect(handler).toHaveBeenCalledTimes(1);
+  });
+
+  it("blocks retained permissive hooks after a failed reload and admits a verified repair", async () => {
+    const { registry, handler } = installGuard();
+    runtime.pinActivePluginChannelRegistry(registry);
+    required.beginRequiredPluginLoad();
+    expect(() =>
+      required.completeRequiredPluginLoad(
+        empty.createEmptyPluginRegistry(),
+        config,
+        required.beginRequiredPluginLoad(),
+      ),
+    ).toThrow();
+    expect(await call()).toMatchObject({ blocked: true, kind: "failure" });
+    expect(handler).not.toHaveBeenCalled();
+    required.completeRequiredPluginLoad(registry, config, required.beginRequiredPluginLoad());
+    expect(await call()).toMatchObject({ blocked: false });
+    expect(handler).toHaveBeenCalledTimes(1);
+  });
+});
